{
  "info": {
    "name": "EventPulse",
    "description": "EventPulse API - auth, events, registrations, categories, and real-time announcements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Attendee\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/register",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Jane Attendee\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"token\": \"eyJhbGciOi...\",\n  \"data\": {\n    \"id\": \"66f1a2b3c4d5e6f7a8b9c0d1\",\n    \"name\": \"Jane Attendee\",\n    \"email\": \"jane@example.com\",\n    \"role\": \"user\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.token) {",
                  "  pm.environment.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventpulse.com\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/api/auth/login",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@eventpulse.com\",\n  \"password\": \"admin123\"\n}"
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"token\": \"eyJhbGciOi...\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events?page=1&limit=10&sortBy=date&order=asc"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "url": "{{baseUrl}}/api/events" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"data\": [ { \"_id\": \"...\", \"title\": \"Summer Music Festival\", \"category\": { \"_id\": \"...\", \"name\": \"Music\" }, \"organizer\": { \"_id\": \"...\", \"name\": \"Admin User\" }, \"date\": \"2026-07-15T00:00:00.000Z\", \"city\": \"Cairo\", \"capacity\": 200 } ],\n  \"total\": 1,\n  \"page\": 1,\n  \"limit\": 10,\n  \"totalPages\": 1\n}"
            }
          ]
        },
        {
          "name": "Get single event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/events/:id",
            "variable": [{ "key": "id", "value": "REPLACE_WITH_REAL_EVENT_ID" }]
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "GET", "url": "{{baseUrl}}/api/events/:id" },
