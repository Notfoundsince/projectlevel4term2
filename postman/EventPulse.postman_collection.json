            }
          ]
        },
        {
          "name": "Cancel registration",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "url": "{{baseUrl}}/api/registrations/:id",
            "variable": [{ "key": "id", "value": "REPLACE_WITH_REAL_REGISTRATION_ID" }]
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "DELETE", "url": "{{baseUrl}}/api/registrations/:id" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Registration cancelled successfully\"\n}"
            },
            {
              "name": "403 Not your registration",
              "originalRequest": { "method": "DELETE", "url": "{{baseUrl}}/api/registrations/:id" },
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"fail\",\n  \"message\": \"You can only cancel your own registration\"\n}"
            }
          ]
        }
      ]
