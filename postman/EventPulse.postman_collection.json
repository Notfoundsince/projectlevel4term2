          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "PATCH", "url": "{{baseUrl}}/api/events/:id" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"data\": { \"_id\": \"...\", \"capacity\": 75 }\n}"
            }
          ]
        },
        {
          "name": "Delete event (admin only)",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "url": "{{baseUrl}}/api/events/:id",
            "variable": [{ "key": "id", "value": "REPLACE_WITH_REAL_EVENT_ID" }]
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "DELETE", "url": "{{baseUrl}}/api/events/:id" },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Event deleted\"\n}"
            }
          ]
        }
      ]
