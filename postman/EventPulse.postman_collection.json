              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"data\": { \"_id\": \"...\", \"title\": \"Summer Music Festival\", \"category\": { \"_id\": \"...\", \"name\": \"Music\" }, \"organizer\": { \"_id\": \"...\", \"name\": \"Admin User\" } }\n}"
            }
          ]
        },
        {
          "name": "Create event (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "url": "{{baseUrl}}/api/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Conference\",\n  \"description\": \"A test event created via Postman\",\n  \"category\": \"REPLACE_WITH_A_REAL_CATEGORY_ID\",\n  \"date\": \"2026-12-01T10:00:00.000Z\",\n  \"city\": \"Cairo\",\n  \"capacity\": 50\n}"
            }
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/api/events" },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"success\",\n  \"data\": { \"_id\": \"...\", \"title\": \"Test Conference\", \"organizer\": \"...\" }\n}"
            },
            {
              "name": "403 Forbidden (non-admin)",
              "originalRequest": { "method": "POST", "url": "{{baseUrl}}/api/events" },
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"fail\",\n  \"message\": \"You do not have permission to perform this action\"\n}"
            }
