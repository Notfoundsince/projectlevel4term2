        },
        {
          "name": "Update event (admin only)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "url": "{{baseUrl}}/api/events/:id",
            "variable": [{ "key": "id", "value": "REPLACE_WITH_REAL_EVENT_ID" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 75\n}"
            }
